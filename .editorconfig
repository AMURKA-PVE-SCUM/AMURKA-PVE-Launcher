root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = false
trim_trailing_whitespace = true

[*.{cs,xaml}]
indent_style = space
indent_size = 4

[*.cs]
# Amurka.Shared is a C#-only solution namespace; VB.NET 'Shared' keyword interop does not apply.
dotnet_diagnostic.CA1716.severity = none

# Allow idiomatic Result<T>.Success(...) / Result<T>.Failure(...) factory methods on generic Result<T>.
dotnet_diagnostic.CA1000.severity = none

# Keep structured ILogger extension calls ergonomic outside ultra-hot per-frame paths.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
