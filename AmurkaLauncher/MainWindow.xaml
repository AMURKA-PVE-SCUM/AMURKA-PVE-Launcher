<Window x:Class="AmurkaLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Amurka.Shared.UI.Controls;assembly=Amurka.Shared"
        xmlns:vm="clr-namespace:AmurkaLauncher.Presentation.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="AMURKA PVE Launcher"
        Height="560" Width="960"
        MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#0A0A0A"
        Icon="Resources/icon.ico"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <!-- Reusable Cyberpunk Mode Button Style -->
        <Style x:Key="ModeToggleBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="12">
        <Grid ClipToBounds="True">
            <!-- Background Layer -->
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.3" GradientOrigin="0.5,0.3" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#141028" Offset="0"/>
                    <GradientStop Color="#0A0A0A" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>

            <!-- Animated Particles (Retained DrawingVisual - Zero Layout Invalidation) -->
            <controls:ParticleCanvas IsHitTestVisible="False"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Custom Title Bar (Dark Cyberpunk) -->
                <Border Grid.Row="0" Background="#90090D14" BorderBrush="#18FFFFFF" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Branding & Icon & Sleek Top Version Pill -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Image Source="Resources/icon.ico" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="AMURKA" FontWeight="Black" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Text="PVE" FontWeight="Black" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            <Border Background="#1600FF88" BorderBrush="#3500FF88" BorderThickness="1" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="LAUNCHER" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            </Border>

                            <!-- Sleek Branded Top Version Badge -->
                            <Border Background="#1A0D1117" BorderBrush="#3500FF88" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Cursor="Hand" ToolTip="Статус клиента. Нажмите для проверки обновлений.">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding CheckForUpdatesCommand}"/>
                                </Border.InputBindings>
                                <Border.Effect>
                                    <DropShadowEffect Color="#00FF88" BlurRadius="8" Opacity="0.25" ShadowDepth="0"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,5,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#00FF88" BlurRadius="6" ShadowDepth="0"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="v" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding AppVersionText}" FontSize="9.5" FontWeight="Black" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Center: Draggable Area -->
                        <Grid Grid.Column="1" Background="Transparent"/>

                        <!-- Right: Window Action Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <!-- Minimize -->
                            <Button Style="{StaticResource TitleBarBtnStyle}" Click="MinimizeBtn_Click" ToolTip="Свернуть">
                                <Path Data="{StaticResource IconWinMinimizeGeometry}"
                                      Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Maximize / Restore -->
                            <Button x:Name="MaximizeBtn" Style="{StaticResource TitleBarBtnStyle}" Click="MaximizeBtn_Click" ToolTip="Развернуть">
                                <Path x:Name="MaximizeIconPath" Data="{StaticResource IconWinMaximizeGeometry}"
                                      Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2" StrokeLineJoin="Round"
                                      Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Close -->
                            <Button Style="{StaticResource TitleBarCloseBtnStyle}" Click="CloseBtn_Click" ToolTip="Закрыть">
                                <Path Data="{StaticResource IconWinCloseGeometry}"
                                      Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dedicated Notification Banner (Row 1 - Never overlaps inputs) -->
                <Border Grid.Row="1" Margin="14,10,14,0"
                        Background="#F0091C14" BorderBrush="#6000FF88" BorderThickness="1" CornerRadius="10" Padding="14,8"
                        Visibility="{Binding ModSync.IsSyncBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Effect>
                        <DropShadowEffect Color="#00FF88" BlurRadius="20" Opacity="0.25" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0" Data="{StaticResource IconSparklesGeometry}" Fill="{StaticResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding ModSync.SyncBannerTitle}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{Binding ModSync.SyncBannerDescription}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Margin="0,0,8,0" Padding="14,6" Cursor="Hand" Command="{Binding SynchronizeModsCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{StaticResource AccentGradientBrush}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconRefreshGeometry}" Stroke="#0A0A0A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Синхронизировать" FontSize="11" FontWeight="Bold" Foreground="#0A0A0A" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Padding="10,6" Cursor="Hand" Command="{Binding ModSync.DismissBannerCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="Позже" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Layout -->
                <Grid Grid.Row="2" Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT PANEL -->
                    <Border Grid.Column="0" Background="#10FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Logo -->
                                <RowDefinition Height="Auto"/> <!-- Progress -->
                                <RowDefinition Height="Auto"/> <!-- Status -->
                                <RowDefinition Height="Auto"/> <!-- Stats -->
                                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                                <RowDefinition Height="Auto"/> <!-- Mode Select -->
                                <RowDefinition Height="*"/>    <!-- Spacer -->
                                <RowDefinition Height="Auto"/> <!-- Footer -->
                            </Grid.RowDefinitions>

                            <!-- Logo Section -->
                            <Grid Grid.Row="0">
                                <StackPanel>
                                    <TextBlock Text="AMURKA" FontSize="28" FontWeight="Black" Foreground="#FFFFFF"/>
                                    <TextBlock Text="PVE MOD" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,6"/>
                                    <Border Background="#14FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="14"
                                            Padding="10,4" HorizontalAlignment="Left" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding CopyServerInfoCommand}"/>
                                        </Border.InputBindings>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="SCUM Server | 85.88.179.207:7004" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Path Data="{StaticResource IconCopyGeometry}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="11" Height="11" Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Progress Section -->
                            <StackPanel Grid.Row="1" Margin="0,10,0,0" Visibility="{Binding ModSync.IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ProgressBar Style="{StaticResource CustomProgressBarStyle}" Value="{Binding ModSync.DownloadProgressPercent}"/>
                                <TextBlock Text="{Binding ModSync.DownloadProgressLabel}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Status Badge -->
                            <Border Grid.Row="2" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
                                        <Setter Property="BorderBrush" Value="#2500FF88"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStatusOk}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource DangerDimBrush}"/>
                                                <Setter Property="BorderBrush" Value="#25FF4757"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#00FF88" BlurRadius="8" ShadowDepth="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStatusOk}" Value="False">
                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#FF4757" BlurRadius="8" ShadowDepth="0"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStatusOk}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Stats Row -->
                            <Grid Grid.Row="3" Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ModSync.AvailableCount}" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                    <TextBlock Text="ДОСТУПНО" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <Rectangle Grid.Column="1" Fill="#20FFFFFF" Height="26"/>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ModSync.InstalledCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="УСТАНОВЛЕНО" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Row="4" Margin="0,0,0,10">
                                <!-- Launch Button -->
                                <Button Margin="0,0,0,6" Height="42" Cursor="Hand" Command="{Binding LaunchGameCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{StaticResource AccentGradientBrush}" CornerRadius="8">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#00FF88" BlurRadius="20" Opacity="0.3" ShadowDepth="0"/>
                                                </Border.Effect>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconPlayGeometry}" Fill="#0A0A0A" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="ЗАПУСТИТЬ ИГРУ" FontSize="13" FontWeight="Bold" Foreground="#0A0A0A" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Download Selected -->
                                <Button Margin="0,0,0,6" Height="38" Cursor="Hand" Command="{Binding SynchronizeModsCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{StaticResource AccentDimBrush}" BorderBrush="#3500FF88" BorderThickness="1" CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconRefreshGeometry}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="СИНХРОНИЗИРОВАТЬ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#3500FF88"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Delete All Mods -->
                                <Button Height="36" Cursor="Hand" Command="{Binding DeleteModsCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="Transparent" BorderBrush="#35FF4757" BorderThickness="1" CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconTrashGeometry}" Stroke="{StaticResource DangerBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="УДАЛИТЬ ВСЕ МОДЫ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource DangerDimBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- Mode Select -->
                            <StackPanel Grid.Row="5" Margin="0,0,0,10">
                                <TextBlock Text="РЕЖИМ ЗАПУСКА" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,6"/>
                                <Border Background="#44000000" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- DX11 -->
                                        <Button Grid.Column="0" Content="DX11" Command="{Binding SetLaunchModeCommand}" CommandParameter="dx11">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModeToggleBtnStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDx11}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="Foreground" Value="#0A0A0A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- DX12 -->
                                        <Button Grid.Column="1" Content="DX12" Command="{Binding SetLaunchModeCommand}" CommandParameter="dx12">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModeToggleBtnStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDx12}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="Foreground" Value="#0A0A0A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Vulkan -->
                                        <Button Grid.Column="2" Content="Vulkan" Command="{Binding SetLaunchModeCommand}" CommandParameter="vulkan">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModeToggleBtnStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVulkan}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="Foreground" Value="#0A0A0A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Footer -->
                            <Border Grid.Row="7" Background="#14000000" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,4" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="AMURKA PVE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text=" · " FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                    <TextBlock Text="Created by " FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                    <TextBlock Text="DOMO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PurpleBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- RIGHT PANEL -->
                    <Border Grid.Column="2" Background="#10FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Title: Installation Paths -->
                                <RowDefinition Height="Auto"/> <!-- Game Path -->
                                <RowDefinition Height="Auto"/> <!-- Mods Path -->
                                <RowDefinition Height="Auto"/> <!-- Title: Links -->
                                <RowDefinition Height="Auto"/> <!-- Links Grid -->
                                <RowDefinition Height="Auto"/> <!-- Title: Tools -->
                                <RowDefinition Height="Auto"/> <!-- Tools Content -->
                                <RowDefinition Height="*"/>    <!-- Spacer -->
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="ПУТИ УСТАНОВКИ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                            <!-- Game Path Group -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                <TextBlock Text="Папка с игрой SCUM" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource CustomTextBoxStyle}"
                                             Text="{Binding Settings.GamePathText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding Settings.GamePathText}"
                                             LostFocus="GamePathInput_LostFocus"/>
                                    <Button Grid.Column="2" Width="38" Height="36" Cursor="Hand" Command="{Binding Settings.BrowseGameFolderCommand}" ToolTip="Выбрать папку с игрой"
                                            Background="{StaticResource PurpleDimBrush}" BorderBrush="#306C5CE7" BorderThickness="1">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                    <Path Data="{StaticResource IconFolderOpenGeometry}" Fill="{StaticResource PurpleBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Settings.IsGameFound}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Settings.GameStatusDescription}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Mods Path Group -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                                <TextBlock Text="Папка модификаций (~mods)" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource CustomTextBoxStyle}"
                                             Text="{Binding Settings.ModsPathText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding Settings.ModsPathText}"
                                             LostFocus="ModsPathInput_LostFocus"/>
                                    <Button Grid.Column="2" Width="38" Height="36" Cursor="Hand" Command="{Binding Settings.BrowseModsFolderCommand}" ToolTip="Выбрать папку модов"
                                            Background="{StaticResource PurpleDimBrush}" BorderBrush="#306C5CE7" BorderThickness="1">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                    <Path Data="{StaticResource IconFolderOpenGeometry}" Fill="{StaticResource PurpleBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Links Section -->
                            <TextBlock Grid.Row="3" Text="ССЫЛКИ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                            <Grid Grid.Row="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Vote -->
                                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource LinkBtnStyle}"
                                        Background="{StaticResource PurpleDimBrush}" BorderBrush="#356C5CE7" Foreground="{StaticResource PurpleBrush}"
                                        Command="{Binding OpenUrlCommand}" CommandParameter="https://wargm.ru/server/77385/votes">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconFlameGeometry}" Fill="{StaticResource PurpleBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Голосование" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Shop -->
                                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource LinkBtnStyle}"
                                        Background="#20FDCB6E" BorderBrush="#35FDCB6E" Foreground="{StaticResource YellowBrush}"
                                        Command="{Binding OpenUrlCommand}" CommandParameter="https://wargm.ru/server/77385/shop">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconShoppingBagGeometry}" Stroke="{StaticResource YellowBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Магазин" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Website -->
                                <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource LinkBtnStyle}"
                                        Background="{StaticResource AccentDimBrush}" BorderBrush="#3500FF88" Foreground="{StaticResource AccentBrush}"
                                        Command="{Binding OpenUrlCommand}" CommandParameter="https://amurka-pve-scum.github.io/">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconGlobeGeometry}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Сайт сервера" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Lolka -->
                                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource LinkBtnStyle}"
                                        Background="#205865F2" BorderBrush="#355865F2" Foreground="{StaticResource DiscordBrush}"
                                        Command="{Binding OpenUrlCommand}" CommandParameter="https://lolka.gg/nmgHA2I">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconMessagesGeometry}" Stroke="{StaticResource DiscordBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Discord Lolka" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Tools / Maintenance Section -->
                            <TextBlock Grid.Row="5" Text="ОБСЛУЖИВАНИЕ SCUM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,8"/>

                            <Border Grid.Row="6" Background="#14000000" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="Очистка клиента и кэша" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Закрывает SCUM и удаляет кэш %LOCALAPPDATA%\SCUM при сбоях" FontSize="9.5" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Height="34" Padding="14,0" Cursor="Hand" Command="{Binding WipeClientCommand}"
                                            Background="{StaticResource DangerDimBrush}" BorderBrush="#35FF4757" BorderThickness="1">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconTrashGeometry}" Stroke="{StaticResource DangerBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Очистить" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#35FF4757"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- UPDATE MODAL OVERLAY -->
            <Grid Background="#B0000000" Visibility="{Binding UpdateModal.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="380" Background="#F012111E" BorderBrush="#606C5CE7" BorderThickness="1" CornerRadius="16" Padding="32"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#6C5CE7" BlurRadius="40" Opacity="0.4" ShadowDepth="0"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="{StaticResource PurpleDimBrush}" BorderBrush="#406C5CE7" BorderThickness="1" CornerRadius="20" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Path Data="{StaticResource IconRefreshGeometry}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Доступно обновление" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding UpdateModal.UpdateVersion}" FontSize="26" FontWeight="Black" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                        <TextBlock Text="{Binding UpdateModal.UpdateDescription}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>

                        <!-- Update Progress -->
                        <StackPanel Margin="0,0,0,16" Visibility="{Binding UpdateModal.IsDownloadingUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ProgressBar Height="6" Background="#20FFFFFF" Value="{Binding UpdateModal.UpdateProgressPercent}">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                            <Grid x:Name="PART_Track">
                                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource PurpleGradientBrush}"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                            <TextBlock Text="{Binding UpdateModal.UpdateProgressLabel}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Padding="20,8" Margin="0,0,8,0" Cursor="Hand" Command="{Binding UpdateModal.DownloadUpdateCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{StaticResource AccentGradientBrush}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconDownloadGeometry}" Stroke="#0A0A0A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Скачать" FontSize="12" FontWeight="Bold" Foreground="#0A0A0A" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Padding="16,8" Cursor="Hand" Command="{Binding UpdateModal.DismissCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="Позже" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- TOAST NOTIFICATION (Bottom) -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                    Background="#E60A0A0A" BorderThickness="1" CornerRadius="8"
                    Padding="16,8" Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsToastError}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect Color="#00FF88" BlurRadius="16" Opacity="0.3" ShadowDepth="0"/>
                </Border.Effect>
                <TextBlock Text="{Binding ToastText}" FontSize="12" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsToastError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>
    </Border>
</Window>