<Window x:Class="AmurkaLauncher.Controls.AmurkaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AMURKA PVE"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">

    <Border x:Name="OuterBorder" Margin="16" Background="#F20D1117" BorderBrush="#3500FF88" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect x:Name="GlowEffect" Color="#00FF88" BlurRadius="25" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.2" GradientOrigin="0.5,0.2" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#1A1230" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="38"/> <!-- TitleBar -->
                <RowDefinition Height="*"/>  <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="#66000000" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="AMURKA" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                    <TextBlock Text=" PVE" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="2,0,8,0"/>
                    <TextBlock Text="·" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TitleText" Text="Уведомление" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource TitleBarCloseBtnStyle}" Content="✕" Width="34" Height="26" Margin="0,0,6,0" Click="CloseBtn_Click"/>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="20,18,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border x:Name="IconBadge" Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                        Background="#2000FF88" BorderBrush="#4000FF88" BorderThickness="1"
                        VerticalAlignment="Top" Margin="0,2,16,0">
                    <TextBlock x:Name="IconGlyph" Text="ℹ" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                </Border>

                <!-- Message Text -->
                <TextBlock x:Name="MessageText" Grid.Column="1" Text="Текст сообщения..."
                           Foreground="#E8FFFFFF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Buttons Area -->
            <Border Grid.Row="2" Background="#40000000" BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Cancel / No Button -->
                    <Button x:Name="CancelBtn" Margin="0,0,10,0" Padding="18,7" Cursor="Hand" Click="CancelBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="Transparent" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#20FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="CancelBtnText" Text="Отмена" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>

                    <!-- Confirm / Yes / OK Button -->
                    <Button x:Name="ConfirmBtn" Padding="20,7" Cursor="Hand" Click="ConfirmBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ConfirmBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00FF88" BlurRadius="12" Opacity="0.3" ShadowDepth="0"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ConfirmBorder" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="ConfirmBtnText" Text="ОК" FontSize="11.5" FontWeight="Bold" Foreground="#0A0A0A"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
