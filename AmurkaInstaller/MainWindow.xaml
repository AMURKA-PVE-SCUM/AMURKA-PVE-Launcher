<Window x:Class="AmurkaInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AmurkaInstaller.Controls"
        mc:Ignorable="d"
        Title="Установка AMURKA PVE Launcher"
        Height="490" Width="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="Resources/icon.ico">

    <Border BorderBrush="#3000FF88" BorderThickness="1" CornerRadius="14">
        <Grid ClipToBounds="True">
            <!-- Background Layer -->
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.2" GradientOrigin="0.5,0.2" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#181333" Offset="0"/>
                    <GradientStop Color="#0A0A0A" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>

            <!-- Animated Particles -->
            <controls:ParticleCanvas IsHitTestVisible="False"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Custom Title Bar -->
                <Border Grid.Row="0" Background="#90090D14" BorderBrush="#18FFFFFF" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Branding -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Image Source="Resources/icon.ico" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="AMURKA" FontWeight="Black" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Text="PVE" FontWeight="Black" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            <Border Background="#1600FF88" BorderBrush="#3500FF88" BorderThickness="1" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="УСТАНОВЩИК" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Right: Window Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Button Style="{StaticResource TitleBarBtnStyle}" Click="MinimizeBtn_Click" ToolTip="Свернуть">
                                <Path Data="{StaticResource IconWinMinimizeGeometry}"
                                      Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource TitleBarCloseBtnStyle}" Click="CloseBtn_Click" ToolTip="Закрыть">
                                <Path Data="{StaticResource IconWinCloseGeometry}"
                                      Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- STEP 1: WELCOME & OPTIONS VIEW -->
                <Grid x:Name="WelcomeView" Grid.Row="1" Margin="30,20,30,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Path Card -->
                        <RowDefinition Height="Auto"/> <!-- Checkboxes -->
                        <RowDefinition Height="*"/>    <!-- Action Button -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="AMURKA " FontSize="26" FontWeight="Black" Foreground="#FFFFFF"/>
                            <TextBlock Text="PVE LAUNCHER" FontSize="26" FontWeight="Black" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Официальный быстрый клиент для автоматической синхронизации модов и входа на сервер SCUM."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Border Background="#1800FF88" BorderBrush="#3000FF88" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock x:Name="VersionBadgeText" Text="Версия: v2.1.29" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                            <Border Background="#186C5CE7" BorderBrush="#306C5CE7" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="Сервер: 85.88.179.207:7004" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PurpleBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Path Card -->
                    <Border Grid.Row="1" Background="#0E121A" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Папка установки программы" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#40000000" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8">
                                    <TextBox x:Name="InstallPathInput" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                             Padding="12,10" FontSize="12" TextChanged="InstallPathInput_TextChanged"/>
                                </Border>

                                <Button x:Name="BrowseBtn" Grid.Column="2" Width="42" Height="38" Cursor="Hand" Click="BrowseBtn_Click"
                                        Background="{StaticResource PurpleDimBrush}" BorderBrush="#356C5CE7" BorderThickness="1">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                <Path Data="{StaticResource IconFolderOpenGeometry}" Fill="{StaticResource PurpleBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="DiskSpaceInfoText" Text="Вычисляется свободное место на диске..." FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Margin="2,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Options -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,16">
                        <CheckBox x:Name="CreateDesktopShortcutCheck" Content="Создать ярлык на Рабочем столе" Style="{StaticResource CyberCheckBoxStyle}" IsChecked="True" Margin="0,0,0,8"/>
                        <CheckBox x:Name="CreateStartMenuShortcutCheck" Content="Создать ярлык в меню «Пуск»" Style="{StaticResource CyberCheckBoxStyle}" IsChecked="True"/>
                    </StackPanel>

                    <!-- Action Button -->
                    <Grid Grid.Row="3" VerticalAlignment="Bottom">
                        <Button x:Name="StartInstallBtn" Height="44" Cursor="Hand" Click="StartInstallBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{StaticResource AccentGradientBrush}" CornerRadius="8">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#00FF88" BlurRadius="25" Opacity="0.35" ShadowDepth="0"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconPlayGeometry}" Fill="#0A0A0A" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="УСТАНОВИТЬ ЛАУНЧЕР" FontSize="13" FontWeight="Bold" Foreground="#0A0A0A" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>

                <!-- STEP 2: INSTALLING PROGRESS VIEW -->
                <Grid x:Name="InstallingView" Grid.Row="1" Margin="40,40,40,30" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Width="520">
                        <Border Background="{StaticResource AccentDimBrush}" BorderBrush="#3500FF88" BorderThickness="1" CornerRadius="24" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Data="{StaticResource IconSparklesGeometry}" Fill="{StaticResource AccentBrush}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="InstallTitleText" Text="Установка AMURKA PVE Launcher..." FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Распаковка файлов и регистрация клиента в Windows..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <!-- Progress Bar -->
                        <Border Background="#20FFFFFF" CornerRadius="4" Height="8" Margin="0,0,0,8">
                            <Grid x:Name="ProgressBarTrack">
                                <Border x:Name="ProgressBarIndicator" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource AccentGradientBrush}" Width="0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00FF88" BlurRadius="12" Opacity="0.5" ShadowDepth="0"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="0,4,0,0">
                            <TextBlock x:Name="InstallStatusText" Text="Подготовка файлов..." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" MaxWidth="440"/>
                            <TextBlock x:Name="InstallPercentText" Text="0%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- STEP 3: FINISHED VIEW -->
                <Grid x:Name="FinishedView" Grid.Row="1" Margin="40,30,40,30" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Width="520">
                        <Border Background="{StaticResource AccentDimBrush}" BorderBrush="#4000FF88" BorderThickness="1" CornerRadius="28" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Data="{StaticResource IconCheckGeometry}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="FinishedTitleText" Text="Установка успешно завершена!" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock x:Name="FinishedDescText" Text="AMURKA PVE Launcher готов к работе и запуску." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <Border x:Name="InstalledPathCard" Background="#0E121A" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Папка установки:" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                <TextBlock x:Name="InstalledPathText" Text="" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="LaunchAppBtn" Width="220" Height="42" Cursor="Hand" Click="LaunchAppBtn_Click" Margin="0,0,12,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{StaticResource AccentGradientBrush}" CornerRadius="8">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#00FF88" BlurRadius="20" Opacity="0.35" ShadowDepth="0"/>
                                            </Border.Effect>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconPlayGeometry}" Fill="#0A0A0A" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="ЗАПУСТИТЬ ЛАУНЧЕР" FontSize="12" FontWeight="Bold" Foreground="#0A0A0A" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Width="110" Height="42" Cursor="Hand" Click="CloseBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="8">
                                            <TextBlock Text="Закрыть" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- STEP 4: UNINSTALL VIEW -->
                <Grid x:Name="UninstallView" Grid.Row="1" Margin="40,30,40,30" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Width="520">
                        <Border Background="#25FF4757" BorderBrush="#40FF4757" BorderThickness="1" CornerRadius="28" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Data="{StaticResource IconWinCloseGeometry}" Stroke="{StaticResource DangerBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Удаление AMURKA PVE Launcher" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Вы действительно хотите удалить AMURKA PVE Launcher с вашего компьютера?" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Width="160" Height="42" Cursor="Hand" Click="ConfirmUninstallBtn_Click" Margin="0,0,12,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{StaticResource DangerBrush}" CornerRadius="8">
                                            <TextBlock Text="Да, удалить" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Width="110" Height="42" Cursor="Hand" Click="CloseBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="8">
                                            <TextBlock Text="Отмена" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
